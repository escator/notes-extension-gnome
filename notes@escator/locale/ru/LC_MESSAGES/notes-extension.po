#: notes@escator/extension.js
msgid "Show notes"
msgstr "Показать заметки"

#: notes@escator/extension.js
msgid "Notes extension error: failed to load a note"
msgstr "Ошибка расширения заметок: не удалось загрузить заметку"

#: notes@escator/extension.js
msgid "New note"
msgstr "Новая заметка"

#: notes@escator/extension.js
msgid "New from Clipboard"
msgstr "Новая из буфера обмена"

#: notes@escator/extension.js notes@escator/prefs.ui
msgid "Settings"
msgstr "Настройки"

#: notes@escator/extension.js
msgid "Filter by color"
msgstr "Фильтр по цвету"

#: notes@escator/extension.js
msgid "Reset filter"
msgstr "Сбросить фильтр"

#: notes@escator/menus.js
msgid "Font size"
msgstr "Размер шрифта"

#: notes@escator/menus.js
msgid "Cut"
msgstr "Вырезать"

#: notes@escator/menus.js
msgid "Copy"
msgstr "Копировать"

#: notes@escator/menus.js
msgid "Paste"
msgstr "Вставить"

#: notes@escator/menus.js
msgid "Undo"
msgstr "Отменить"

#: notes@escator/menus.js
msgid "Redo"
msgstr "Повторить"

#: notes@escator/menus.js
msgid "Select All"
msgstr "Выделить всё"

#: notes@escator/noteBox.js
msgid "Edit"
msgstr "Редактировать"

#: notes@escator/noteBox.js
msgid "Copy to clipboard"
msgstr "Копировать в буфер обмена"

#: notes@escator/noteBox.js
msgid "Paste from clipboard"
msgstr "Вставить из буфера обмена"

#: notes@escator/noteBox.js
msgid "Delete"
msgstr "Удалить"

#: notes@escator/noteBox.js
msgid "Note options"
msgstr "Параметры заметки"

#: notes@escator/noteBox.js
msgid "Resize"
msgstr "Изменить размер"

#: notes@escator/noteBox.js
msgid "Type here…"
msgstr "Введите текст…"

#: notes@escator/noteBox.js
msgid "Empty note"
msgstr "Пустая заметка"

#: notes@escator/noteBox.js
msgid "Delete this note?"
msgstr "Удалить эту заметку?"

#: notes@escator/noteBox.js
msgid "Edit title"
msgstr "Изменить заголовок"

#: notes@escator/noteBox.js notes@escator/prefs.ui
msgid "Apply"
msgstr "Применить"

#: notes@escator/prefs.js
msgid "Modifications will be effective after reloading the extension."
msgstr "Изменения вступят в силу после перезагрузки расширения."

#: notes@escator/prefs.js
#, javascript-format
msgid "Default value is %s"
msgstr "Значение по умолчанию: %s"

#: notes@escator/prefs.js
#, javascript-format
msgid "Version %s"
msgstr "Версия %s"

#: notes@escator/prefs.ui
msgid "Use a keyboard shortcut"
msgstr "Использовать комбинацию клавиш"

#: notes@escator/prefs.ui
msgid "Use a keyboard shortcut to toggle notes visibility"
msgstr "Использовать комбинацию клавиш для показа и скрытия заметок"

#: notes@escator/prefs.ui
msgid "Help"
msgstr "Справка"

#: notes@escator/prefs.ui
msgid "Hide the icon"
msgstr "Скрыть значок"

#: notes@escator/prefs.ui
msgid "First note's color"
msgstr "Цвет первой заметки"

#: notes@escator/prefs.ui
msgid "The notes created afterwards will use the color of their parent"
msgstr "Заметки, созданные позже, будут наследовать цвет родительской заметки"

#: notes@escator/prefs.ui
msgid ""
"Your notes are saved to the disk on various occasions (mainly when you hide "
"them). If you want to <b>get a copy of your notes</b>, this button opens the "
"folder where they are."
msgstr ""
"Заметки сохраняются на диск в различных ситуациях (в основном, когда вы их "
"скрываете). Если вы хотите <b>получить копию своих заметок</b>, эта кнопка "
"откроет папку, в которой они находятся."

#: notes@escator/prefs.ui
msgid "Open the storage directory"
msgstr "Открыть папку с заметками"

#: notes@escator/prefs.ui
msgid ""
"The \"layouts.json\" file contains the color and position of your notes for "
"each monitor configuration"
msgstr ""
"Файл \"layouts.json\" содержит цвет и положение заметок для каждой "
"конфигурации мониторов"

#: notes@escator/prefs.ui
msgid "Files ending with \"_text\" contain the text written in your notes"
msgstr "Файлы, оканчивающиеся на \"_text\", содержат текст ваших заметок"

#: notes@escator/prefs.ui
msgid "Backup"
msgstr "Резервное копирование"

#: notes@escator/prefs.ui
msgid "Explanations about how to use this extension can be found here:"
msgstr "О том, как пользоваться расширением, можно прочитать здесь:"

#: notes@escator/prefs.ui
msgid "Online help manual"
msgstr "Онлайн-руководство"

#: notes@escator/prefs.ui
msgid ""
"Click on this button if you accidentally moved a note out of your primary "
"monitor (example: if you had notes on a secondary monitor and unplugged it)."
msgstr ""
"Нажмите эту кнопку, если заметка случайно оказалась за пределами основного "
"монитора (например, если заметки были на втором мониторе, а вы его "
"отключили)."

#: notes@escator/prefs.ui
msgid "Bring back to the primary monitor"
msgstr "Вернуть на основной монитор"

#: notes@escator/prefs.ui
msgid "(fork of the sticky notes extension for the GNOME Shell desktop)"
msgstr "(форк расширения для заметок на рабочем столе.)"

#: notes@escator/prefs.ui
msgid ""
"Reworked design and extended functionality:\n"
"• Improved visual style and interface\n"
"• Better sticky notes on the screen\n"
"• Text context menu with edit history\n"
"• New notes from the clipboard\n"
"• Note expanding for long texts\n"
"• New notes with a double click on the panel icon\n"
"• Color filter in the panel menu\n"
"• Proper multi-monitor support"
msgstr ""
"Переработанный дизайн и расширенная функциональность:\n"
"• Улучшен визуальный стиль и интерфейс\n"
"• Улучшенная работа с заметками на экране\n"
"• Контекстное меню текста с историей правок\n"
"• Создание заметок из буфера обмена\n"
"• Разворачивание заметки для длинных текстов\n"
"• Новые заметки двойным кликом по значку панели\n"
"• Цветовой фильтр заметок в меню панели\n"
"• Корректная работа на нескольких мониторах"

#: notes@escator/prefs.ui
msgid "Based on the original extension by Romain F. T. (maoschanz)"
msgstr "Основано на оригинальном расширении Romain F.T. (maoschanz)"

#: notes@escator/prefs.ui
msgid "Fork  https://github.com/maoschanz/notes-extension-gnome"
msgstr "Форк  https://github.com/maoschanz/notes-extension-gnome"

#: notes@escator/prefs.ui
msgid "Developer: Pavel Chernyakov (escator)"
msgstr "Автор разработчик: Pavel Chernyakov (escator)"

#: notes@escator/prefs.ui
msgid "Report bugs or ideas"
msgstr "Сообщить об ошибке или предложить идею"

#: notes@escator/prefs.ui
msgid "About"
msgstr "О расширении"

#: notes@escator/prefs.ui
msgid "List of valid key names"
msgstr "Список допустимых названий клавиш"

#. Context for translation: modifier keys are ctrl/shift/super/alt
#: notes@escator/prefs.ui
msgid "Modifier keys must be between chevrons"
msgstr "Клавиши-модификаторы должны быть заключены в угловые скобки"

#: notes@escator/prefs.ui
msgid "Don't use a keyboard shortcut that already exists."
msgstr "Не используйте комбинацию клавиш, которая уже занята."

#~ msgid "Hide the notes on a click outside"
#~ msgstr "Скрывать заметки по клику вне их"

#~ msgid ""
#~ "While the notes are visible, a click anywhere outside of their area hides "
#~ "them, like the main toggle"
#~ msgstr ""
#~ "Пока заметки видимы, клик в любое место вне их области скрывает их — как "
#~ "основной переключатель"

#: notes@maestroschan.fr/prefs.ui
msgid ""
"Your notes are saved to the disk on various occasions (mainly when you hide "
"them). If you want to <b>get a copy of your notes</b>, this button opens the "
"folder where they are."
msgstr ""
"Bilješke se spremaju na disk u različitim prilikama (uglavnom kad ih "
"sakriješ). Ako želiš <b>dobiti kopiju svojih bilješki</b>, ovaj gumb otvara "
"mapu gdje se one nalaze."

#: notes@maestroschan.fr/prefs.ui
msgid "Open the storage directory"
msgstr "Otvori mapu za spremanje"

#: notes@maestroschan.fr/prefs.ui
msgid ""
"The \"layouts.json\" file contains the color and position of your notes for "
"each monitor configuration"
msgstr ""

#: notes@maestroschan.fr/prefs.ui
msgid "Files ending with \"_text\" contain the text written in your notes"
msgstr "Datoteke s nastavkom „_text” sadrže tekst tvojih bilježaka"

